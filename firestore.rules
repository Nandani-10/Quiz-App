rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety catch-all
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Hosts collection definition
    match /hosts/{email} {
      allow get, write: if true;
      
      // Reports subcollection definition
      match /reports/{reportId} {
        allow read, write: if true;
      }
    }
    
    // Active sessions definition
    match /sessions/{code} {
      allow read, write: if true;
    }
  }
}
